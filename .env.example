# Deployer wallet private key (with or without the 0x prefix).
# On Arc this wallet pays gas in USDC, so it must hold USDC before deploying.
PRIVATE_KEY=your_wallet_private_key

# Optional RPC overrides. Defaults are Circle's public Arc endpoints.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
